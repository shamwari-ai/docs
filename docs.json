{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Shamwari",
  "colors": {
    "primary": "#283593",
    "light": "#3D5AFE",
    "dark": "#3D5AFE"
  },
  "background": {
    "color": {
      "light": "#f3f3f1",
      "dark": "#0e0d0c"
    },
    "decoration": "grid"
  },
  "fonts": {
    "heading": {
      "family": "Noto Serif",
      "weight": 600
    },
    "body": {
      "family": "Noto Sans",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/images/favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "rules",
          "scopes"
        ]
      },
      {
        "group": "How it works",
        "pages": [
          "architecture",
          "routing",
          "ground",
          "language",
          "traffic"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@shamwari.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "shamwari.ai",
      "href": "https://shamwari.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/shamwari-ai/shamwari"
    }
  },
  "description": "Shamwari is an AI companion built in Zimbabwe. Personal data never reaches a third-party model; only open-weight output trains Shamwari Mind — both enforced in code, not just claimed on a page."
}
